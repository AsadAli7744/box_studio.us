ADMIN_USERNAME=
ADMIN_PASSWORD=
PORT=3000

# Final production domain for canonicals/sitemap (must be www)
NEXT_PUBLIC_SITE_URL=https://www.boxstudio.us

# Optional indexing override. Leave unset in production.
# www.boxstudio.us / boxstudio.us are indexable by host check alone.
# Staging Railway/localhost hosts are blocked automatically.
# Set true only if you need a non-production host indexed for testing.
# NEXT_PUBLIC_ALLOW_INDEXING=true

# Google Tag Manager container ID
NEXT_PUBLIC_GTM_ID=GTM-KPP5W583

# Quote artwork + request storage (AWS S3)
AWS_REGION=us-east-1
AWS_S3_BUCKET=
# Object key prefix inside the bucket (default: quotes)
AWS_S3_QUOTES_PREFIX=quotes
# Required unless the host provides IAM role / shared AWS credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional if using temporary credentials
AWS_SESSION_TOKEN=

# Hosting / CDN note:
# Do not block Googlebot, Bingbot, OAI-SearchBot, ChatGPT-User, or PerplexityBot
# in Railway, Cloudflare, or firewall bot-fight settings for public pages.
